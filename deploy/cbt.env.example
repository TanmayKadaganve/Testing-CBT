# ==============================================================================
# PyForgeLabs CBT — Production Environment Variables Configuration
# Copy this file to /etc/cbt/cbt.env and set restrictive permissions: chmod 600 /etc/cbt/cbt.env
# ==============================================================================

# Core Django Secrets
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY="REPLACE_WITH_GENERATED_SECRET"
DJANGO_DEBUG="False"

# Network & Host Permissions (Use actual college server LAN IP and local hostname)
DJANGO_ALLOWED_HOSTS="192.168.10.10,exam.cbt.college.lan,127.0.0.1,localhost"
DJANGO_CSRF_TRUSTED_ORIGINS="https://192.168.10.10,https://exam.cbt.college.lan"

# Production PostgreSQL Database Connection
# Production startup requires a PostgreSQL DATABASE_URL or DB_ENGINE=postgresql.
DATABASE_URL="postgresql://cbt_user:REPLACE_WITH_DATABASE_PASSWORD@127.0.0.1:5432/cbt_db"
DB_CONN_MAX_AGE="60"

# HTTPS is required in production; Nginx must forward X-Forwarded-Proto: https.
DJANGO_SECURE_SSL_REDIRECT="True"

# Isolated code execution. Install Podman and build the image in deploy/runner/Dockerfile.
CODE_EXECUTION_BACKEND="container"
CODE_EXECUTION_CONTAINER_RUNTIME="podman"
CODE_EXECUTION_CONTAINER_IMAGE="pyforgelabs/runner:latest"
EXECUTION_WORKER_HEARTBEAT_DIR="/var/lib/cbt/worker-heartbeats"

# Server Concurrency Tuning
GUNICORN_BIND="127.0.0.1:8000"
GUNICORN_WORKERS="8"
GUNICORN_THREADS="4"
